RABBITMQ_URL=amqp://rabbitmq:123456@localhost:5672

# Each service owns its database (database per service)
ORDERS_DATABASE_URL=postgresql://postgres:123456@localhost:5432/orders_db
INVENTORY_DATABASE_URL=postgresql://postgres:123456@localhost:5432/inventory_db
PAYMENTS_DATABASE_URL=postgresql://postgres:123456@localhost:5432/payments_db
COURIERS_DATABASE_URL=postgresql://postgres:123456@localhost:5432/delivery_db
NOTIFICATIONS_DATABASE_URL=postgresql://postgres:123456@localhost:5432/notifications_db

# Optional settings (defaults shown)
# GATEWAY_PORT=3000
# ORDERS_PORT=3001
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173   browser origins allowed to call the gateway
# ORDERS_URL=http://localhost:3001   where the gateway reaches the orders read side (internal only)
# SAGA_STEP_TIMEOUT_MS=30000      how long a saga waits for a participant's reply
# SAGA_TIMEOUT_POLL_MS=1000       how often to look for expired steps
# OUTBOX_POLL_INTERVAL_MS=1000    fallback outbox polling (the relay is normally woken right after commit)
# OUTBOX_BATCH_SIZE=100
# OUTBOX_LEASE_MS=30000           how long an outbox row is leased while being sent
# OUTBOX_RETENTION_DAYS=7         how long to keep sent messages and inbox records
