{
  "name": "delivery-gateway",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/gateway/test/jest-e2e.json",
    "topology": "ts-node -r dotenv/config scripts/setup-topology.ts",
    "db": "ts-node scripts/prisma-each.ts",
    "db:generate": "yarn -s db generate",
    "db:migrate": "yarn -s db migrate deploy",
    "db:status": "yarn -s db migrate status",
    "db:seed": "yarn -s db db seed --only=inventory,couriers",
    "db:seed:reset": "yarn -s db db seed --only=inventory,couriers --reset",
    "setup": "docker compose up -d --wait && yarn topology && yarn db:migrate && yarn db:seed",
    "start:gateway": "nest start gateway --watch",
    "start:orders": "nest start orders --watch",
    "start:inventory": "nest start inventory --watch",
    "start:payments": "nest start payments --watch",
    "start:couriers": "nest start couriers --watch",
    "start:notifications": "nest start notifications --watch",
    "start:all": "trap 'kill 0' EXIT; yarn start:orders & yarn start:inventory & yarn start:payments & yarn start:couriers & yarn start:notifications & yarn start:gateway & wait",
    "postinstall": "yarn -s db:generate"
  },
  "dependencies": {
    "@nestjs/common": "12",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "12",
    "@nestjs/microservices": "^12.0.3",
    "@nestjs/platform-express": "12",
    "@nestjs/typeorm": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "12",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "12",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "dotenv": "^18.0.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.111.1",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/messaging(|/.*)$": "<rootDir>/libs/messaging/src/$1",
      "^@app/outbox(|/.*)$": "<rootDir>/libs/outbox/src/$1"
    }
  }
}
