// payments_db database. Customer accounts and payments.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

model Account {
  customerId   String   @id @map("customer_id")
  /// CHECK (balance_cents >= 0) is added manually in the migration.
  balanceCents Int      @map("balance_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("accounts")
}

enum PaymentStatus {
  CHARGED
  FAILED
  REFUNDED
}

/// Outcome of the charge command — success or rejection alike. A repeated command
/// gets the same reply via idempotencyKey and is never charged twice.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  idempotencyKey String        @unique @map("idempotency_key")
  sagaId         String        @map("saga_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  customerId     String        @map("customer_id")
  amountCents    Int           @map("amount_cents")
  status         PaymentStatus
  failureReason  String?       @map("failure_reason")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([sagaId])
  @@index([customerId])
  @@map("payments")
}

// ─── @app/outbox service tables. Identical in every service. ───

/// Outgoing messages: written in the same transaction as the business data;
/// OutboxRelay sends them to RabbitMQ.
model OutboxMessage {
  id          String    @id @db.Uuid
  routingKey  String    @map("routing_key")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_messages")
}

/// Processed incoming messages: protection against redelivery.
model InboxMessage {
  messageId   String   @map("message_id")
  handler     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([messageId, handler])
  @@index([processedAt])
  @@map("inbox_messages")
}
